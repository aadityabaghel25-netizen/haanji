# Copy to .env and fill in. Never commit .env.
# Gnani API key (app.gnani.ai/voice). Empty = offline mode: typed questions, no voice.
GNANI_API_KEY=
# Optional
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=hi-IN,en-IN
GNANI_TTS_MODEL=timbre-v3.0
GNANI_AGENT_VOICE=Shivani
GNANI_TTS_LANGUAGE=hi-en
# Set this before putting the app online: protects /seller
SELLER_PASSWORD=
